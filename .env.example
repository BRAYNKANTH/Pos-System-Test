# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Everyone on the team points at the SAME Supabase project. Ask whoever
# created it (see docs/task-allocation-plan.md) for the connection strings
# instead of creating your own project.

# ── Database (Supabase Postgres) ───────────────────────────────────────────
# Pooled connection (port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Redis / BullMQ (Module 4 — sync queue) ─────────────────────────────────
# Local dev: `docker compose up -d` starts Redis on this port.
REDIS_URL="redis://localhost:6379"

# ── Zoho Books OAuth 2.0 (Module 4) ────────────────────────────────────────
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="http://localhost:3000/api/sync/oauth/callback"

# ── Auth / sessions (shared — lib/auth) ────────────────────────────────────
SESSION_SECRET="generate-a-long-random-string-for-local-dev"

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
