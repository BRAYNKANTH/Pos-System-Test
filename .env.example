# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Database (Supabase Postgres) ───────────────────────────────────────────
# Pooled connection (port 6543) — used by the app at runtime. MUST keep
# `?pgbouncer=true` or Prisma's prepared statements break against pgbouncer
# ("prepared statement already exists" errors).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used only by `prisma migrate`. In the
# Supabase dashboard this is a DIFFERENT host than the pooled one above
# (db.PROJECT_REF.supabase.co, not the pooler.supabase.com host) — grab it
# from Settings → Database → Connection string → "Direct connection".
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"
# If your password contains special characters (@, #, etc.), percent-encode
# them (@ -> %40) or the connection string won't parse correctly.

# ── Zoho Books OAuth 2.0 ────────────────────────────────────────────────
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="http://localhost:3000/api/sync/oauth/callback"

# ── Auth / sessions (shared — lib/auth) ────────────────────────────────────
SESSION_SECRET="generate-a-long-random-string-for-local-dev"

# ── App ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
